#!/usr/bin/env bash
set -euo pipefail

VERSION="0.7.0"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
CODEX_HOME_DIR="${CODEX_HOME:-${HOME}/.codex}"
AGENT_DEST_DIR="${CODEX_HOME_DIR}/agents"
SKILLS_DEST_ROOT="${PANTHEON_SKILLS_HOME:-${HOME}/.agents/skills}"
AGENTS_FILE="${CODEX_HOME_DIR}/AGENTS.md"
VERSION_FILE="${CODEX_HOME_DIR}/.pantheon-version"
BLOCK_FILE="${SCRIPT_DIR}/policy/managed-block.md"
START_MARKER='<!-- PANTHEON:START -->'
END_MARKER='<!-- PANTHEON:END -->'

AGENT_FILES=(
  luna-explorer.toml
  luna-librarian.toml
  luna-fixer.toml
)

LEGACY_AGENT_FILES=(
  pantheon-worker.toml
  pantheon-explorer.toml
  pantheon-librarian.toml
  pantheon-oracle.toml
  pantheon-fixer.toml
  pantheon-designer.toml
  pantheon-reviewer.toml
  pantheon-verifier.toml
)

SKILL_DIRS=(
  pantheon
  pantheon-daily
  pantheon-plan
  pantheon-review
)

LEGACY_SKILL_DIRS=(
  pantheon-team
)

say() { printf '%s\n' "$*"; }
ok() { printf '✓ %s\n' "$*"; }
warn() { printf '! %s\n' "$*" >&2; }
fail() { printf '✗ %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF_USAGE
Codex Pantheon ${VERSION}

Usage:
  ./pantheon bootstrap
  ./pantheon install
  ./pantheon update
  ./pantheon doctor
  ./pantheon verify
  ./pantheon uninstall
  ./pantheon version
  ./pantheon help

Environment:
  CODEX_HOME              Codex home (default: \$HOME/.codex)
  PANTHEON_SKILLS_HOME    Skill root (default: \$HOME/.agents/skills)
EOF_USAGE
}

require_source_tree() {
  [ -f "${SCRIPT_DIR}/VERSION" ] || fail "Missing source VERSION file."
  [ "$(tr -d '[:space:]' < "${SCRIPT_DIR}/VERSION")" = "$VERSION" ] || fail "Source VERSION does not match CLI version ${VERSION}."
  [ -f "$BLOCK_FILE" ] || fail "Missing policy/managed-block.md."

  local f
  for f in "${AGENT_FILES[@]}"; do
    [ -f "${SCRIPT_DIR}/agents/${f}" ] || fail "Missing source agent: agents/${f}"
    [ ! -L "${SCRIPT_DIR}/agents/${f}" ] || fail "Source agent must be a regular file, not a symlink: agents/${f}"
    grep -q '^name[[:space:]]*=' "${SCRIPT_DIR}/agents/${f}" || fail "Agent missing name: agents/${f}"
    grep -q '^description[[:space:]]*=' "${SCRIPT_DIR}/agents/${f}" || fail "Agent missing description: agents/${f}"
    grep -q '^developer_instructions[[:space:]]*=' "${SCRIPT_DIR}/agents/${f}" || fail "Agent missing developer_instructions: agents/${f}"
  done

  for f in "${LEGACY_AGENT_FILES[@]}"; do
    [ ! -e "${SCRIPT_DIR}/agents/${f}" ] && [ ! -L "${SCRIPT_DIR}/agents/${f}" ] || fail "Legacy source agent must not exist in v${VERSION}: agents/${f}"
  done

  for f in "${SKILL_DIRS[@]}"; do
    [ -f "${SCRIPT_DIR}/skills/${f}/SKILL.md" ] || fail "Missing source skill: skills/${f}/SKILL.md"
    grep -q '^name:' "${SCRIPT_DIR}/skills/${f}/SKILL.md" || fail "Skill missing name metadata: skills/${f}/SKILL.md"
    grep -q '^description:' "${SCRIPT_DIR}/skills/${f}/SKILL.md" || fail "Skill missing description metadata: skills/${f}/SKILL.md"
  done

  for f in "${LEGACY_SKILL_DIRS[@]}"; do
    [ ! -e "${SCRIPT_DIR}/skills/${f}" ] && [ ! -L "${SCRIPT_DIR}/skills/${f}" ] || fail "Legacy source skill must not exist in v${VERSION}: skills/${f}"
  done
}

marker_count() {
  local marker="$1"
  local file="$2"
  if [ ! -f "$file" ]; then
    printf '0\n'
    return
  fi
  grep -Fxc "$marker" "$file" 2>/dev/null || true
}

validate_marker_state() {
  [ -e "$AGENTS_FILE" ] || return 0
  [ -f "$AGENTS_FILE" ] || fail "${AGENTS_FILE} exists but is not a regular file. Refusing to modify it."
  [ ! -L "$AGENTS_FILE" ] || fail "${AGENTS_FILE} is a symlink. Refusing to modify it."

  local starts ends
  starts="$(marker_count "$START_MARKER" "$AGENTS_FILE")"
  ends="$(marker_count "$END_MARKER" "$AGENTS_FILE")"

  if [ "$starts" -ne "$ends" ] || [ "$starts" -gt 1 ]; then
    fail "Malformed or duplicate Pantheon markers in ${AGENTS_FILE}. Fix them manually before install/update/uninstall."
  fi
}

replace_or_append_block() {
  validate_marker_state
  mkdir -p "$CODEX_HOME_DIR"

  if [ ! -e "$AGENTS_FILE" ]; then
    cp "$BLOCK_FILE" "$AGENTS_FILE"
    chmod 0644 "$AGENTS_FILE" 2>/dev/null || true
    return
  fi

  local starts tmp
  starts="$(marker_count "$START_MARKER" "$AGENTS_FILE")"
  tmp="$(mktemp "${CODEX_HOME_DIR}/.pantheon-agents.XXXXXX")"
  trap 'rm -f "$tmp"' RETURN

  if [ "$starts" -eq 0 ]; then
    cat "$AGENTS_FILE" > "$tmp"
    if [ -s "$AGENTS_FILE" ]; then
      printf '\n' >> "$tmp"
    fi
    cat "$BLOCK_FILE" >> "$tmp"
    printf '\n' >> "$tmp"
  else
    awk -v start="$START_MARKER" -v end="$END_MARKER" -v block="$BLOCK_FILE" '
      function emit_block( line) {
        while ((getline line < block) > 0) print line
        close(block)
      }
      $0 == start { emit_block(); in_block=1; next }
      in_block && $0 == end { in_block=0; next }
      !in_block { print }
    ' "$AGENTS_FILE" > "$tmp"
  fi

  mv "$tmp" "$AGENTS_FILE"
  trap - RETURN
}

remove_block() {
  validate_marker_state
  [ -f "$AGENTS_FILE" ] || return 0

  local starts tmp
  starts="$(marker_count "$START_MARKER" "$AGENTS_FILE")"
  [ "$starts" -eq 1 ] || return 0

  tmp="$(mktemp "${CODEX_HOME_DIR}/.pantheon-agents.XXXXXX")"
  trap 'rm -f "$tmp"' RETURN

  awk -v start="$START_MARKER" -v end="$END_MARKER" '
    $0 == start { in_block=1; next }
    in_block && $0 == end { in_block=0; next }
    !in_block { print }
  ' "$AGENTS_FILE" > "$tmp"

  if grep -q '[^[:space:]]' "$tmp"; then
    mv "$tmp" "$AGENTS_FILE"
  else
    rm -f "$tmp" "$AGENTS_FILE"
  fi
  trap - RETURN
}

copy_regular_file() {
  local src="$1"
  local dst="$2"
  rm -f "$dst"
  cp "$src" "$dst"
  chmod 0644 "$dst" 2>/dev/null || true
}

remove_legacy_payload() {
  local f
  for f in "${LEGACY_AGENT_FILES[@]}"; do
    rm -f "${AGENT_DEST_DIR}/${f}"
  done
  for f in "${LEGACY_SKILL_DIRS[@]}"; do
    rm -rf "${SKILLS_DEST_ROOT}/${f}"
  done
}

install_payload() {
  require_source_tree
  validate_marker_state
  mkdir -p "$AGENT_DEST_DIR" "$SKILLS_DEST_ROOT"

  remove_legacy_payload

  local f dest
  for f in "${AGENT_FILES[@]}"; do
    copy_regular_file "${SCRIPT_DIR}/agents/${f}" "${AGENT_DEST_DIR}/${f}"
  done

  for f in "${SKILL_DIRS[@]}"; do
    dest="${SKILLS_DEST_ROOT}/${f}"
    rm -rf "$dest"
    mkdir -p "$dest"
    cp -R "${SCRIPT_DIR}/skills/${f}/." "$dest/"
    chmod 0644 "${dest}/SKILL.md" 2>/dev/null || true
  done

  replace_or_append_block
  printf '%s\n' "$VERSION" > "$VERSION_FILE"
  chmod 0644 "$VERSION_FILE" 2>/dev/null || true
}

cmd_install() {
  install_payload
  say "Codex Pantheon ${VERSION} installed."
  say "Run: ./pantheon doctor"
}

cmd_update() {
  install_payload
  say "Codex Pantheon updated to ${VERSION}."
  say "Run: ./pantheon doctor"
}

cmd_bootstrap() {
  local prior_state="new installation"
  if [ -e "$VERSION_FILE" ] || [ -e "$AGENTS_FILE" ]; then
    if [ -f "$VERSION_FILE" ] || [ "$(marker_count "$START_MARKER" "$AGENTS_FILE")" -gt 0 ]; then
      prior_state="existing/partial installation"
    fi
  fi

  say "Codex Pantheon bootstrap (${prior_state})"
  install_payload
  say "Pantheon-owned files synchronized to v${VERSION}."
  say ""
  cmd_doctor
}

extract_installed_block() {
  local out="$1"
  awk -v start="$START_MARKER" -v end="$END_MARKER" '
    $0 == start { in_block=1 }
    in_block { print }
    $0 == end && in_block { exit }
  ' "$AGENTS_FILE" > "$out"
}

outside_block_contains_pantheon() {
  [ -f "$AGENTS_FILE" ] || return 1
  awk -v start="$START_MARKER" -v end="$END_MARKER" '
    $0 == start { in_block=1; next }
    $0 == end { in_block=0; next }
    !in_block { print }
  ' "$AGENTS_FILE" | grep -Eqi 'codex[[:space:]]+pantheon|\$pantheon|pantheon_(worker|explorer|librarian|oracle|fixer|designer|reviewer|verifier)|luna_(explorer|librarian|fixer)'
}

find_codex() {
  if command -v codex >/dev/null 2>&1; then
    command -v codex
    return 0
  fi
  if [ -x "/Applications/ChatGPT.app/Contents/Resources/codex" ]; then
    printf '%s\n' "/Applications/ChatGPT.app/Contents/Resources/codex"
    return 0
  fi
  return 1
}

cmd_doctor() {
  require_source_tree

  local errors=0 warnings=0 f src dst tmp starts ends codex_bin codex_version
  say "Codex Pantheon Doctor"
  say "Version: ${VERSION}"
  say ""

  say "Core"
  if [ -f "$VERSION_FILE" ] && [ "$(tr -d '[:space:]' < "$VERSION_FILE")" = "$VERSION" ]; then
    ok "Installed version marker: ${VERSION}"
  else
    printf '✗ Installed version marker missing or not ${VERSION}\n' >&2
    errors=$((errors + 1))
  fi

  if codex_bin="$(find_codex 2>/dev/null)"; then
    codex_version="$($codex_bin --version 2>/dev/null | head -n 1 || true)"
    ok "Codex executable: ${codex_bin}${codex_version:+ (${codex_version})}"
  else
    warn "Codex executable not found on PATH or in the standard macOS ChatGPT app bundle; static Pantheon checks can still run."
    warnings=$((warnings + 1))
  fi

  say ""
  say "Agents"
  for f in "${AGENT_FILES[@]}"; do
    src="${SCRIPT_DIR}/agents/${f}"
    dst="${AGENT_DEST_DIR}/${f}"
    if [ -L "$dst" ]; then
      printf '✗ %s is a symlink; Pantheon custom agents must be regular files\n' "$f" >&2
      errors=$((errors + 1))
    elif [ ! -f "$dst" ]; then
      printf '✗ %s is missing\n' "$f" >&2
      errors=$((errors + 1))
    elif cmp -s "$src" "$dst"; then
      ok "$f"
    else
      printf '✗ %s differs from the v%s source package\n' "$f" "$VERSION" >&2
      errors=$((errors + 1))
    fi
  done

  say ""
  say "Legacy cleanup"
  for f in "${LEGACY_AGENT_FILES[@]}"; do
    dst="${AGENT_DEST_DIR}/${f}"
    if [ -e "$dst" ] || [ -L "$dst" ]; then
      printf '✗ legacy Pantheon agent still installed: %s\n' "$f" >&2
      errors=$((errors + 1))
    fi
  done
  for f in "${LEGACY_SKILL_DIRS[@]}"; do
    dst="${SKILLS_DEST_ROOT}/${f}"
    if [ -e "$dst" ] || [ -L "$dst" ]; then
      printf '✗ legacy Pantheon skill still installed: %s\n' "$f" >&2
      errors=$((errors + 1))
    fi
  done
  if [ "$errors" -eq 0 ]; then
    ok "Legacy v0.4/v0.5 Pantheon payload absent"
  fi

  say ""
  say "Skills"
  for f in "${SKILL_DIRS[@]}"; do
    src="${SCRIPT_DIR}/skills/${f}/SKILL.md"
    dst="${SKILLS_DEST_ROOT}/${f}/SKILL.md"
    if [ -L "$dst" ]; then
      printf '✗ %s/SKILL.md is a symlink\n' "$f" >&2
      errors=$((errors + 1))
    elif [ ! -f "$dst" ]; then
      printf '✗ %s is missing\n' "$f" >&2
      errors=$((errors + 1))
    elif cmp -s "$src" "$dst"; then
      ok "$f"
    else
      printf '✗ %s differs from the v%s source package\n' "$f" "$VERSION" >&2
      errors=$((errors + 1))
    fi
  done

  say ""
  say "Policy"
  if [ ! -f "$AGENTS_FILE" ]; then
    printf '✗ %s is missing\n' "$AGENTS_FILE" >&2
    errors=$((errors + 1))
  elif [ -L "$AGENTS_FILE" ]; then
    printf '✗ %s is a symlink; Pantheon refuses to manage it\n' "$AGENTS_FILE" >&2
    errors=$((errors + 1))
  else
    starts="$(marker_count "$START_MARKER" "$AGENTS_FILE")"
    ends="$(marker_count "$END_MARKER" "$AGENTS_FILE")"
    if [ "$starts" -ne 1 ] || [ "$ends" -ne 1 ]; then
      printf '✗ Managed Pantheon marker pair is missing, malformed, or duplicated\n' >&2
      errors=$((errors + 1))
    else
      tmp="$(mktemp "${CODEX_HOME_DIR}/.pantheon-doctor.XXXXXX")"
      extract_installed_block "$tmp"
      if cmp -s "$BLOCK_FILE" "$tmp"; then
        ok "Managed AGENTS.md block matches v${VERSION}"
      else
        printf '✗ Managed AGENTS.md block differs from v%s\n' "$VERSION" >&2
        errors=$((errors + 1))
      fi
      rm -f "$tmp"

      if outside_block_contains_pantheon; then
        warn "Possible legacy/unmanaged Pantheon instructions exist outside the managed block; review them manually before deleting anything."
        warnings=$((warnings + 1))
      fi
    fi
  fi

  say ""
  if [ "$errors" -eq 0 ] && [ "$warnings" -eq 0 ]; then
    say "Status: HEALTHY"
    return 0
  fi
  if [ "$errors" -eq 0 ]; then
    say "Status: HEALTHY WITH WARNINGS (${warnings})"
    return 0
  fi

  say "Status: UNHEALTHY (${errors} error(s), ${warnings} warning(s))"
  say "Repair Pantheon-owned files with: ./pantheon update"
  return 1
}

cmd_verify() {
  require_source_tree

  say "Codex Pantheon Verify"
  say "Version: ${VERSION}"
  say "This runs one real Codex parent turn plus one Luna Explorer child turn."
  say ""
  say "Static preflight"
  cmd_doctor

  local codex_bin explorer_config nonce secret prompt sessions_dir
  local output stderr_file last_message start_marker parent_reply parent_thread_id
  local parent_trace="" child_trace="" spawn_lines spawn_line spawn_count call_id
  local spawn_output_lines spawn_output_count child_count=0 child_reply_count turn_context_line
  local file session_meta_line

  codex_bin="$(find_codex 2>/dev/null)" || fail "Codex executable is required for live verification."
  explorer_config="${AGENT_DEST_DIR}/luna-explorer.toml"
  grep -Eq '^model[[:space:]]*=[[:space:]]*"gpt-5\.6-luna"[[:space:]]*$' "$explorer_config" || fail "Installed luna-explorer.toml does not pin GPT-5.6 Luna."
  grep -Eq '^model_reasoning_effort[[:space:]]*=[[:space:]]*"high"[[:space:]]*$' "$explorer_config" || fail "Installed luna-explorer.toml does not pin High reasoning."

  nonce="$(date +%s)-$$-${RANDOM:-0}"
  secret="PANTHEON_PARENT_SECRET_${nonce}_${RANDOM:-0}"
  prompt="$(cat <<EOF_VERIFY
Pantheon live runtime smoke test. Do not modify files and do not perform unrelated work.

Parent-only secret: ${secret}

Use native MultiAgent V2 spawn_agent exactly once with:
- agent_type: luna_explorer
- fork_turns: none
- task_name: explorer_pantheon_verify

Do NOT include or quote the parent-only secret in the child assignment. Give the child only this assignment:
Pantheon verify nonce: ${nonce}. Inspect only your initial context. If it contains any full token beginning PANTHEON_PARENT_SECRET_, reply exactly PANTHEON_CHILD_FAIL_${nonce}_PARENT_SECRET_SEEN. Otherwise reply exactly PANTHEON_CHILD_OK_${nonce}_NO_PARENT_SECRET. Do not use tools or spawn subagents.

Wait for that child to complete. If its exact reply is PANTHEON_CHILD_OK_${nonce}_NO_PARENT_SECRET, reply exactly PANTHEON_VERIFY_OK_${nonce}. Otherwise reply exactly PANTHEON_VERIFY_FAIL_${nonce}.
EOF_VERIFY
)"

  VERIFY_TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/pantheon-verify.XXXXXX")"
  trap 'rm -rf -- "${VERIFY_TMP_DIR:-}"' EXIT
  output="${VERIFY_TMP_DIR}/events.jsonl"
  stderr_file="${VERIFY_TMP_DIR}/stderr.log"
  last_message="${VERIFY_TMP_DIR}/last-message.txt"
  start_marker="${VERIFY_TMP_DIR}/started"
  : > "$start_marker"

  say ""
  say "Live V2 round trip"
  if ! CODEX_HOME="$CODEX_HOME_DIR" "$codex_bin" exec --json --output-last-message "$last_message" --skip-git-repo-check --sandbox read-only -C "$SCRIPT_DIR" "$prompt" >"$output" 2>"$stderr_file"; then
    cat "$output" >&2 2>/dev/null || true
    cat "$stderr_file" >&2 2>/dev/null || true
    fail "Codex live verification turn failed."
  fi

  [ -f "$last_message" ] || {
    cat "$stderr_file" >&2 2>/dev/null || true
    fail "Codex did not write the requested final-message artifact."
  }
  parent_reply="$(cat "$last_message")"
  if [ "$parent_reply" != "PANTHEON_VERIFY_OK_${nonce}" ]; then
    cat "$output" >&2 2>/dev/null || true
    cat "$stderr_file" >&2 2>/dev/null || true
    fail "Parent final reply was not the exact expected Luna child result."
  fi
  ok "Parent received and reconciled the child result"

  parent_thread_id="$(sed -n 's/.*"type":"thread.started".*"thread_id":"\([^"]*\)".*/\1/p' "$output" | head -n 1)"
  [ -n "$parent_thread_id" ] || fail "Could not read the parent thread id from Codex JSON output."

  sessions_dir="${CODEX_HOME_DIR}/sessions"
  [ -d "$sessions_dir" ] || fail "Codex session rollouts were not found under ${sessions_dir}; cannot verify native spawn metadata."
  parent_trace="$(find "$sessions_dir" -type f -name "*${parent_thread_id}.jsonl" -print -quit 2>/dev/null || true)"
  [ -n "$parent_trace" ] || fail "Could not locate the parent rollout for thread ${parent_thread_id}."

  session_meta_line="$(grep -F '"type":"session_meta"' "$parent_trace" | head -n 1 || true)"
  printf '%s\n' "$session_meta_line" | grep -Fq "\"id\":\"${parent_thread_id}\"" || fail "Parent rollout session metadata does not match the Codex thread id."

  spawn_lines="$(grep -F '"type":"response_item"' "$parent_trace" | grep -F '"type":"function_call"' | grep -F '"name":"spawn_agent"' | grep -F "$nonce" || true)"
  spawn_count="$(printf '%s\n' "$spawn_lines" | grep -c . || true)"
  [ "$spawn_count" -eq 1 ] || fail "Expected exactly one actual spawn_agent function call for the verification nonce; found ${spawn_count}."
  spawn_line="$spawn_lines"
  printf '%s\n' "$spawn_line" | grep -Eq '\\"agent_type\\"[[:space:]]*:[[:space:]]*\\"luna_explorer\\"' || fail "spawn_agent did not request agent_type luna_explorer."
  printf '%s\n' "$spawn_line" | grep -Eq '\\"fork_turns\\"[[:space:]]*:[[:space:]]*\\"none\\"' || fail "spawn_agent did not request fork_turns none."
  printf '%s\n' "$spawn_line" | grep -Eq '\\"task_name\\"[[:space:]]*:[[:space:]]*\\"explorer_pantheon_verify\\"' || fail "spawn_agent did not use explorer_pantheon_verify."
  call_id="$(printf '%s\n' "$spawn_line" | sed -n 's/.*"call_id":"\([^"]*\)".*/\1/p')"
  [ -n "$call_id" ] || fail "Could not correlate the spawn_agent call to its result."

  spawn_output_lines="$(grep -F '"type":"response_item"' "$parent_trace" | grep -F '"type":"function_call_output"' | grep -F "\"call_id\":\"${call_id}\"" || true)"
  spawn_output_count="$(printf '%s\n' "$spawn_output_lines" | grep -c . || true)"
  [ "$spawn_output_count" -eq 1 ] || fail "Expected exactly one correlated spawn_agent result; found ${spawn_output_count}."
  printf '%s\n' "$spawn_output_lines" | grep -Fq 'explorer_pantheon_verify' || fail "Correlated spawn_agent result does not identify the requested task."
  ok "V2 spawn used luna_explorer, fork_turns none, and explorer_pantheon_verify"

  while IFS= read -r file; do
    [ "$file" = "$parent_trace" ] && continue
    session_meta_line="$(grep -F '"type":"session_meta"' "$file" | head -n 1 || true)"
    [ -n "$session_meta_line" ] || continue
    if printf '%s\n' "$session_meta_line" | grep -Fq '"thread_spawn"' \
      && printf '%s\n' "$session_meta_line" | grep -Fq "\"parent_thread_id\":\"${parent_thread_id}\"" \
      && printf '%s\n' "$session_meta_line" | grep -Eq '"agent_path":"[^"]*/explorer_pantheon_verify"' \
      && printf '%s\n' "$session_meta_line" | grep -Fq '"agent_role":"luna_explorer"'; then
      child_count=$((child_count + 1))
      child_trace="$file"
    fi
  done < <(find "$sessions_dir" -type f -name '*.jsonl' -newer "$start_marker" -print 2>/dev/null)

  [ "$child_count" -eq 1 ] || fail "Expected exactly one child rollout with matching parent/role/path provenance; found ${child_count}."
  turn_context_line="$(grep -F '"type":"turn_context"' "$child_trace" | grep -F '"model":"gpt-5.6-luna"' | grep -F '"effort":"high"' | tail -n 1 || true)"
  [ -n "$turn_context_line" ] || fail "Child rollout did not record effective GPT-5.6 Luna High execution."

  child_reply_count="$(grep -F '"type":"response_item"' "$child_trace" | grep -F '"type":"message"' | grep -F '"role":"assistant"' | grep -F '"type":"output_text"' | grep -F "\"text\":\"PANTHEON_CHILD_OK_${nonce}_NO_PARENT_SECRET\"" | wc -l | tr -d '[:space:]')"
  [ "$child_reply_count" -eq 1 ] || fail "Child rollout does not contain exactly one assistant output reply with the expected verification token."
  if grep -Fq "$secret" "$child_trace"; then
    fail "Child rollout contains the parent-only secret; fork_turns none isolation did not hold."
  fi
  ok "Configured Explorer resolved to GPT-5.6 Luna High"
  ok "fork_turns none kept the parent-only secret out of the child context"

  say ""
  say "Status: VERIFIED"
  rm -rf -- "$VERIFY_TMP_DIR"
  unset VERIFY_TMP_DIR
  trap - EXIT
}

cmd_uninstall() {
  validate_marker_state

  local f
  for f in "${AGENT_FILES[@]}" "${LEGACY_AGENT_FILES[@]}"; do
    rm -f "${AGENT_DEST_DIR}/${f}"
  done

  for f in "${SKILL_DIRS[@]}" "${LEGACY_SKILL_DIRS[@]}"; do
    rm -rf "${SKILLS_DEST_ROOT}/${f}"
  done

  remove_block
  rm -f "$VERSION_FILE"

  say "Codex Pantheon ${VERSION} uninstalled."
  say "Other Codex configuration and non-Pantheon skills were preserved."
}

main() {
  local command="${1:-help}"
  shift || true

  case "$command" in
    bootstrap) cmd_bootstrap "$@" ;;
    install) cmd_install "$@" ;;
    update) cmd_update "$@" ;;
    doctor) cmd_doctor "$@" ;;
    verify) cmd_verify "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    version|--version|-v) say "Codex Pantheon ${VERSION}" ;;
    help|--help|-h) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
